+def _n2_chunk(
+    index: int,
+    content: str | None = None,
+    finish_reason: str | None = None,
+    role: str | None = None,
+    tool_calls: list | None = None,
+) -> ModelResponseStream:
+    return ModelResponseStream(
+        id="chatcmpl-n2",
+        created=1751934860,
+        model="gpt-4o",
+        object="chat.completion.chunk",
+        choices=[
+            StreamingChoices(
+                index=index,
+                delta=Delta(role=role, content=content, tool_calls=tool_calls),
+                finish_reason=finish_reason,
+            )
+        ],
+    )
+
+
+def test_stream_chunk_builder_keeps_n_greater_than_one_choices_apart():
+    """#35793: an n=2 stream interleaves one choice per chunk; each index must
+    rebuild into its own choice instead of one concatenation of both."""
+    from litellm import stream_chunk_builder
+
+    chunks = [
+        _n2_chunk(0, "AAA", role="assistant"),
+        _n2_chunk(1, "BBB", role="assistant"),
+        _n2_chunk(0, " aaa"),
+        _n2_chunk(1, " bbb"),
+        _n2_chunk(0, finish_reason="stop"),
+        _n2_chunk(1, finish_reason="length"),
+    ]
+
+    response = stream_chunk_builder(chunks=chunks, messages=[{"role": "user", "content": "hi"}])
+
+    assert [(c.index, c.message.content, c.finish_reason) for c in response.choices] == [
+        (0, "AAA aaa", "stop"),
+        (1, "BBB bbb", "length"),
+    ]
+
+
+def test_stream_chunk_builder_keeps_tool_calls_on_their_own_choice_for_n_greater_than_one():
+    from litellm import stream_chunk_builder
+    from litellm.types.utils import ChatCompletionDeltaToolCall, Function
+
+    chunks = [
+        _n2_chunk(0, "hello", role="assistant"),
+        _n2_chunk(
+            1,
+            role="assistant",
+            tool_calls=[
+                ChatCompletionDeltaToolCall(
+                    id="call_1", index=0, type="function", function=Function(name="lookup_fruit", arguments='{"fruit":')
+                )
+            ],
+        ),
+        _n2_chunk(0, " world", finish_reason="stop"),
+        _n2_chunk(
+            1,
+            tool_calls=[ChatCompletionDeltaToolCall(index=0, function=Function(arguments='"kiwi"}'))],
+            finish_reason="tool_calls",
+        ),
+    ]
+
+    response = stream_chunk_builder(chunks=chunks)
+
+    first, second = response.choices
+    assert (first.message.content, first.message.tool_calls, first.finish_reason) == ("hello world", None, "stop")
+    assert second.message.content is None
+    assert second.finish_reason == "tool_calls"
+    assert [(call.id, call.function.name, call.function.arguments) for call in second.message.tool_calls] == [
+        ("call_1", "lookup_fruit", '{"fruit":"kiwi"}')
+    ]
+
+
+def test_stream_chunk_builder_counts_usage_across_all_choices_for_n_greater_than_one():
+    from litellm import stream_chunk_builder
+
+    usage_chunk: Final = ModelResponseStream(
+        id="chatcmpl-n2",
+        created=1751934860,
+        model="gpt-4o",
+        object="chat.completion.chunk",
+        choices=[],
+        usage=Usage(prompt_tokens=7, completion_tokens=11, total_tokens=18),
+    )
+    chunks = [
+        _n2_chunk(0, "AAA", role="assistant"),
+        _n2_chunk(1, "BBB", role="assistant", finish_reason="stop"),
+        _n2_chunk(0, finish_reason="stop"),
+        usage_chunk,
+    ]
+
+    reported = stream_chunk_builder(chunks=chunks)
+    counted = stream_chunk_builder(chunks=chunks[:-1], messages=[{"role": "user", "content": "hi"}])
+
+    assert (reported.usage.prompt_tokens, reported.usage.completion_tokens) == (7, 11)
+    assert counted.usage.completion_tokens == litellm.token_counter(
+        model="gpt-4o", text="AAABBB", count_response_tokens=True
+    )
+
+
