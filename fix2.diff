--- a/litellm/main.py
+++ b/litellm/main.py
@@ -8930,6 +8930,79 @@ def _simple_text_part(choices: Sequence[object]) -> str | None:
     return content if isinstance(content, str) else ""
 
 
+def _stream_choice_index(choice: object) -> int:
+    index: Final = choice.get("index", 0) if isinstance(choice, dict) else getattr(choice, "index", 0)
+    return index if isinstance(index, int) else 0
+
+
+def _stream_choice_indices(chunks: Sequence) -> frozenset[int]:
+    return frozenset(_stream_choice_index(choice) for chunk in chunks for choice in chunk.get("choices") or ())
+
+
+def _chunks_narrowed_to_choice(chunks: Sequence, index: int) -> list:  # mutable-ok: stream_chunk_builder takes a list
+    """Every chunk that carries choice ``index``, with its choices narrowed to that one."""
+    narrowed: Final = []  # mutable-ok: see return type
+    for chunk in chunks:
+        choices = [  # mutable-ok: choices is a List field
+            choice for choice in chunk.get("choices") or () if _stream_choice_index(choice) == index
+        ]
+        if not choices:
+            continue
+        narrowed.append(
+            {**chunk, "choices": choices} if isinstance(chunk, dict) else chunk.model_copy(update={"choices": choices})
+        )
+    return narrowed
+
+
+def _stream_chunk_builder_per_choice(
+    processor: ChunkProcessor,
+    choice_indices: frozenset[int],
+    messages: Sequence | None,
+    logging_obj: Optional["Logging"],
+    count_prompt_tokens: Callable[[], int] | None,
+) -> ModelResponse:
+    """An ``n > 1`` stream interleaves several choices (#35793). Each choice index
+    is rebuilt on its own through the single-choice path, then usage and cost are
+    computed once over every chunk, including choice-less usage chunks."""
+    chunks: Final = processor.chunks
+    rebuilt_choices: Final = [  # mutable-ok: choices is a List field
+        cast(
+            ModelResponse,
+            stream_chunk_builder(
+                chunks=_chunks_narrowed_to_choice(chunks, index),
+                count_prompt_tokens=lambda: 0,  # prompt tokens are counted once, below
+            ),
+        )
+        .choices[0]
+        .model_copy(update={"index": index})
+        for index in sorted(choice_indices)
+    ]
+    response: Final = processor.build_base_response(chunks)
+    response.choices = rebuilt_choices
+
+    usage: Final = processor.calculate_usage(
+        chunks=chunks,
+        model=chunks[0]["model"],
+        completion_output=get_content_from_model_response(response),
+        messages=messages,
+        reasoning_tokens=processor.count_reasoning_tokens(response),
+        count_prompt_tokens=count_prompt_tokens,
+    )
+    setattr(response, "usage", usage)
+    for chunk in reversed(chunks):
+        hidden = chunk.get("_hidden_params") if isinstance(chunk, dict) else getattr(chunk, "_hidden_params", None)
+        if isinstance(hidden, dict) and "provider_specific_fields" in hidden:
+            response._hidden_params.setdefault("provider_specific_fields", {}).update(
+                hidden["provider_specific_fields"]
+            )
+            break
+
+    _stamp_streaming_usage_cost(usage, response, logging_obj)
+    _set_stream_builder_response_cost(response, logging_obj)
+    processor.apply_provider_assembled_streaming_metadata(response, chunks, logging_obj)
+    return response
+
+
 def stream_chunk_builder(
     chunks: list,
     messages: Sequence | None = None,
